<Project Sdk="Microsoft.NET.Sdk">

  <!-- Version, TFM, nullable and package metadata come from Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CiFail.Cli</RootNamespace>
    <!-- The produced executable is `cifail`(.exe), independent of the project name. -->
    <AssemblyName>cifail</AssemblyName>

    <!-- Package as a .NET global tool (for users who already have .NET). This is the one
         project in the repo that ships as a package, so it opts back in over the
         IsPackable=false default in Directory.Build.props. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cifail</ToolCommandName>
    <PackageId>cifail</PackageId>
    <Description>Local-first CI failure intelligence: what broke, whether it happened before, and how to fix it.</Description>
    <PackageTags>ci;build;logs;diagnostics;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Ship English-only resources to keep the binary lean. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Self-contained single-file publishing so end users need no .NET runtime.
    These only apply when a RuntimeIdentifier is given (i.e. `dotnet publish -r <rid>`,
    see scripts/publish.sh and release.yml), so plain build/test/pack are unaffected.

    Trimming is intentionally OFF. Re-evaluated under R21 (2026-06): a `PublishTrimmed=true`
    spike on the *slim* build still emits pervasive IL2026 trim warnings from reflection-based
    System.Text.Json (the stable PascalCase contract in AnalysisJson/StatsJson, the per-row term
    vectors in SqliteAnalysisRepository, the notification payloads, the AI providers, HttpAnalysisStore)
    plus IL2104 from Spectre.Console.Cli and the YAML rule-pack loader. Making it trim-safe would mean
    source-generated JSON contexts throughout and replacing YamlDotNet — disproportionate to the size
    win for a tool already shipped as a single self-contained file. So trimming (and NativeAOT, which
    is stricter still) stays deferred; revisit if these dependencies gain trim/AOT support.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CiFail.Core\CiFail.Core.csproj" />
  </ItemGroup>

  <!--
    External DB providers (Postgres/MySQL/SQL Server/MongoDB) are opt-in to keep the
    default binary small. Pass `-p:IncludeExternalDb=true` (the Docker / full build) to
    reference CiFail.Providers and light up the CIFAIL_EXTERNAL_DB code path in Program.cs.
    Without it, the slim build ships SQLite only and never pulls in EF Core / the drivers.
  -->
  <PropertyGroup Condition="'$(IncludeExternalDb)' == 'true'">
    <DefineConstants>$(DefineConstants);CIFAIL_EXTERNAL_DB</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeExternalDb)' == 'true'">
    <ProjectReference Include="..\CiFail.Providers\CiFail.Providers.csproj" />
  </ItemGroup>

  <!--
    Server mode (`cifail serve`, ASP.NET Core) ships only in the full / Docker build, tied
    to the same switch so one flag produces the complete image. The slim binaries get
    neither the `serve` command nor the ASP.NET Core framework reference.
  -->
  <PropertyGroup Condition="'$(IncludeExternalDb)' == 'true'">
    <DefineConstants>$(DefineConstants);CIFAIL_SERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeExternalDb)' == 'true'">
    <ProjectReference Include="..\CiFail.Server\CiFail.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

</Project>
