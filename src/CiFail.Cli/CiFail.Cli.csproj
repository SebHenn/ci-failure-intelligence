<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CiFail.Cli</RootNamespace>
    <!-- The produced executable is `cifail`(.exe), independent of the project name. -->
    <AssemblyName>cifail</AssemblyName>

    <!-- Package as a .NET global tool (for users who already have .NET) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cifail</ToolCommandName>
    <PackageId>cifail</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Sebastian Henn</Authors>
    <Description>Local-first CI failure intelligence: what broke, whether it happened before, and how to fix it.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SebHenn/ci-failure-intelligence</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SebHenn/ci-failure-intelligence</RepositoryUrl>
    <PackageTags>ci;build;logs;diagnostics;cli;dotnet-tool</PackageTags>

    <!-- Ship English-only resources to keep the binary lean. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Self-contained single-file publishing so end users need no .NET runtime.
    These only apply when a RuntimeIdentifier is given (i.e. `dotnet publish -r <rid>`,
    see scripts/publish.sh and release.yml), so plain build/test/pack are unaffected.
    Trimming is intentionally OFF: EF Core + reflection-based YAML/JSON don't trim
    safely. NativeAOT is likewise deferred for the same reason.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CiFail.Core\CiFail.Core.csproj" />
  </ItemGroup>

  <!--
    External DB providers (Postgres/MySQL/SQL Server/MongoDB) are opt-in to keep the
    default binary small. Pass `-p:IncludeExternalDb=true` (the Docker / full build) to
    reference CiFail.Providers and light up the CIFAIL_EXTERNAL_DB code path in Program.cs.
    Without it, the slim build ships SQLite only and never pulls in EF Core / the drivers.
  -->
  <PropertyGroup Condition="'$(IncludeExternalDb)' == 'true'">
    <DefineConstants>$(DefineConstants);CIFAIL_EXTERNAL_DB</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeExternalDb)' == 'true'">
    <ProjectReference Include="..\CiFail.Providers\CiFail.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

</Project>
