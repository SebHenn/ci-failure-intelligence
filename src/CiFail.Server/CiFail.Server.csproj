<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>CiFail.Server</RootNamespace>
    <!-- This is a library the CLI hosts (CiFailServer.Run), not a standalone web app, so it
         has no static-web-assets pipeline of its own; the dashboard renders from C# (Blazor
         static SSR) with its CSS inlined in App.razor — no node build, no wwwroot to serve. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!--
    A Razor class library that hosts ASP.NET Core (Kestrel + minimal API + Blazor static SSR).
    Microsoft.NET.Sdk.Razor compiles the .razor dashboard components into this assembly; the
    FrameworkReference (rather than Sdk.Web) keeps it a *library* the CLI can call into via
    CiFailServer.Run instead of a second executable with its own Main. Ships only in the full /
    Docker build (gated by CIFAIL_SERVER), so the slim binaries never pull in ASP.NET Core.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CiFail.Core\CiFail.Core.csproj" />
  </ItemGroup>

  <!-- Served verbatim by GET /openapi.json. Embedded rather than copied to disk because this
       assembly is hosted by the CLI's single-file binary, which has no content directory. -->
  <ItemGroup>
    <EmbeddedResource Include="openapi.json" />
  </ItemGroup>

</Project>
