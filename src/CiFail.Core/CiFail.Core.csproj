<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CiFail.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Let the unit tests reach internal test seams (e.g. the channels' injectable poster). -->
  <ItemGroup>
    <InternalsVisibleTo Include="CiFail.Core.Tests" />
  </ItemGroup>

  <!-- Embed default rule packs so the tool works with zero external files -->
  <ItemGroup>
    <EmbeddedResource Include="rulepacks\**\*.yaml" />
  </ItemGroup>

</Project>
